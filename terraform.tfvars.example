# ─────────────────────────────────────────────────────────────────────────────
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in sensitive values.
# terraform.tfvars is gitignored — NEVER commit it.
# ─────────────────────────────────────────────────────────────────────────────

project    = "engine-policies"
aws_region = "us-east-1"

# ── LOCAL DEV (LocalStack) ────────────────────────────────────────────────────
environment              = "local"
localstack_endpoint      = "http://localhost:4566"
create_network_resources = false
create_api_gateway       = false

# ── STAGING / PROD (comment local block above and uncomment below) ────────────
# environment              = "prod"
# localstack_endpoint      = ""          # empty = real AWS
# create_network_resources = true
# create_api_gateway       = true

# ── Application ───────────────────────────────────────────────────────────────
app_backend_url = "http://host.docker.internal:8080"   # local
# app_backend_url = "http://internal-alb.example.com"  # prod: ALB DNS

app_port = 8080

# ── Redis / ElastiCache ───────────────────────────────────────────────────────
redis_host     = "localhost"                        # local dev Redis container
# redis_host   = "engine-policies.xxxxx.cache.amazonaws.com"  # prod ElastiCache
redis_port     = 6379
redis_password = ""                                 # prod: strong password here (never commit)

# ── SSM Parameters ────────────────────────────────────────────────────────────
# Must be below the P99 SLA of 500ms. Overridden per rule via timeout_ms in DynamoDB.
default_timeout_ms = 450

# ── Networking (prod only) ────────────────────────────────────────────────────
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
